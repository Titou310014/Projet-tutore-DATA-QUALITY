### `schema.yml`

```yaml
version: 2

sources:
  - name: data_quality
    database: data-quality-489709
    schema: data_quality
    tables:
      - name: consommation_avignon
  - name: elus_deputes
    database: data-quality-489709
    schema: elus_deputes
    tables:
      - name: elus_deputes

models:
  - name: consommation_avignon
    columns:
      - name: operateur
        tests:
          - not_null
      - name: annee
        tests:
          - not_null
      - name: code_commune
        tests:
          - not_null

  - name: stg_data_quality__consommation_avignon
    columns:
      - name: operateur
        tests:
          - not_null
      - name: annee
        tests:
          - not_null
      - name: code_commune
        tests:
          - not_null

  - name: elus_deputes
    columns:
      - name: nom_elu
        tests:
          - not_null
      - name: prenom_elu
        tests:
          - not_null
      - name: code_departement
        tests:
          - not_null:
              config:
                severity: warn
      - name: date_naissance
        tests:
          - not_null
      - name: code_sexe
        tests:
          - accepted_values:
              values: ['M', 'F']
```

